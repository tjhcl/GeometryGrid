<Window x:Class="GeometryGrid.App.AddObjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加几何对象" Width="780" Height="720" MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackdropBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E0EB"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassFloatingPanelStyle}"
                Margin="16,14,16,4" Padding="24,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="添加几何对象" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="使用可视化表单配置，或直接粘贴完整 JSON 对象定义。"
                               Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#A8FFFFFF" BorderBrush="#8FFFFFFF"
                        BorderThickness="1" CornerRadius="14" Padding="12,6">
                    <TextBlock Text="JSON 1.0" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="EditorTabs" Grid.Row="1" Margin="20,16,20,8"
                    Background="Transparent" BorderBrush="#DDE5EF">
            <TabItem Header="可视化配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="对象 ID（必填）" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="IdBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="对象类型" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="TypeBox" IsEditable="True">
                                            <ComboBoxItem Content="fixedPoint"/>
                                            <ComboBoxItem Content="segment"/>
                                            <ComboBoxItem Content="ray"/>
                                            <ComboBoxItem Content="lineThroughPoints"/>
                                            <ComboBoxItem Content="midpoint"/>
                                            <ComboBoxItem Content="intersectionPoint"/>
                                            <ComboBoxItem Content="gridIntersectionPoint"/>
                                            <ComboBoxItem Content="pointOnLine"/>
                                            <ComboBoxItem Content="pointOnCircle"/>
                                            <ComboBoxItem Content="parallelLine"/>
                                            <ComboBoxItem Content="perpendicularLine"/>
                                            <ComboBoxItem Content="circleByCenterRadius"/>
                                            <ComboBoxItem Content="circleByCenterPoint"/>
                                            <ComboBoxItem Content="circleByDiameter"/>
                                            <ComboBoxItem Content="circleByThreePoints"/>
                                            <ComboBoxItem Content="arc"/>
                                            <ComboBoxItem Content="semicircleByDiameter"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="显示名称（可选）" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="NameBox"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="几何参数" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="x 表达式" Style="{StaticResource LabelStyle}"/><TextBox x:Name="XBox"/></StackPanel>
                                    <StackPanel Margin="7,0,0,0"><TextBlock Text="y 表达式" Style="{StaticResource LabelStyle}"/><TextBox x:Name="YBox"/></StackPanel>
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="pointA" Style="{StaticResource LabelStyle}"/><TextBox x:Name="PointABox"/></StackPanel>
                                    <StackPanel Margin="7,0,0,0"><TextBlock Text="pointB" Style="{StaticResource LabelStyle}"/><TextBox x:Name="PointBBox"/></StackPanel>
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="pointC" Style="{StaticResource LabelStyle}"/><TextBox x:Name="PointCBox"/></StackPanel>
                                    <StackPanel Margin="7,0,0,0"><TextBlock Text="center" Style="{StaticResource LabelStyle}"/><TextBox x:Name="CenterBox"/></StackPanel>
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="objectA" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ObjectABox"/></StackPanel>
                                    <StackPanel Margin="7,0,0,0"><TextBlock Text="objectB" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ObjectBBox"/></StackPanel>
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="radius 表达式" Style="{StaticResource LabelStyle}"/><TextBox x:Name="RadiusBox"/></StackPanel>
                                    <StackPanel Margin="7,0,0,0"><TextBlock Text="selector（first/second）" Style="{StaticResource LabelStyle}"/><TextBox x:Name="SelectorBox"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,12,0,8">
                            <StackPanel>
                                <TextBlock Text="外观与标签" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="颜色" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="ColorBox" Text="#000000"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="线宽" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="StrokeWidthBox" Text="3.5"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <CheckBox x:Name="VisibleCheck" Content="显示对象" IsChecked="True" Margin="0,4,22,4"/>
                                    <CheckBox x:Name="DraggableCheck" Content="允许拖动" Margin="0,4,22,4"/>
                                    <CheckBox x:Name="LabelCheck" Content="显示名称标签" Margin="0,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="从当前表单生成 JSON →" HorizontalAlignment="Right"
                                Click="GenerateJson_Click" Background="#EFF6FF" Foreground="#1D4ED8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="直接键入 JSON">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="粘贴单个 objects 数组成员；可使用 JSON 创建规范中的全部字段。"
                               Foreground="#64748B" Margin="0,0,0,10"/>
                    <TextBox x:Name="JsonBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource GlassSurfaceBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                CornerRadius="18" Margin="16,4,16,14" Padding="16,10">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="450" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Background="#FFFFFF"/>
                    <Button Content="添加对象" Click="Add_Click" IsDefault="True"
                            Background="{StaticResource GlassAccentBrush}"
                            Foreground="White" BorderBrush="#AFFFFFFF"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
