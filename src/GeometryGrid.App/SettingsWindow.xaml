<Window x:Class="GeometryGrid.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeometryGrid 设置" Width="690" Height="610"
        MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackdropBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource GlassButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#8FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource GlassButtonHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9A7EB3F2"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".7">
            <Ellipse Width="390" Height="390" Canvas.Left="-140" Canvas.Top="-170">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#594F8BFF" Offset="0"/>
                        <GradientStop Color="#004F8BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="430" Height="430" Canvas.Right="-170" Canvas.Bottom="-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4673E3FF" Offset="0"/>
                        <GradientStop Color="#0073E3FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Border Style="{StaticResource GlassFloatingPanelStyle}"
                Margin="16,14,16,4" Padding="24,18">
            <StackPanel>
                <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="调整 GeometryGrid 的计算与实验功能。"
                           Margin="0,5,0,0" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="24,20">
            <StackPanel>
                <TextBlock Text="视觉与性能" FontSize="13" FontWeight="SemiBold"
                            Foreground="#64748B" Margin="3,0,0,8"/>

                <Border Style="{StaticResource GlassFloatingPanelStyle}"
                        CornerRadius="22" Padding="21">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Liquid Glass 动态玻璃"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="视觉增强 · 默认关闭"
                                           Foreground="#2563EB" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="LiquidGlassCheckBox"
                                      Grid.Column="1" VerticalAlignment="Center"
                                      FontSize="15" Content="启用"/>
                        </Grid>
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="#475569" LineHeight="22"
                                   Text="开启后使用 WebGL 实时折射、色散和动态光影；关闭后切换到轻量 WPF 玻璃主题，并挂起 WebView2 渲染以降低 CPU、GPU 与内存占用。保存后立即生效，无需重启。"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="实验功能" FontSize="13" FontWeight="SemiBold"
                           Foreground="#64748B" Margin="3,20,0,8"/>

                <Border Style="{StaticResource GlassFloatingPanelStyle}"
                        CornerRadius="22" Padding="21">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GPU 候选批处理加速"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="实验性 · 默认关闭"
                                           Foreground="#7C3AED" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="GpuAccelerationCheckBox"
                                      Grid.Column="1" VerticalAlignment="Center"
                                      FontSize="15" Content="启用"/>
                        </Grid>

                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                   Foreground="#475569" LineHeight="22"
                                   Text="显卡批量评估大量候选点对，CPU 继续负责精确交点、依赖关系和最终验解。小题可能不会更快；不支持 DirectX 12 硬件计算时会自动退回 CPU。"/>

                        <Border Background="#A7FFFFFF" BorderBrush="#86FFFFFF"
                                BorderThickness="1" CornerRadius="15"
                                Padding="14" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="硬件状态" FontWeight="SemiBold"
                                               Foreground="#334155"/>
                                    <TextBlock x:Name="GpuStatusText"
                                               Text="等待检测…"
                                               TextWrapping="Wrap"
                                               Foreground="#64748B"
                                               Margin="0,5,12,0"/>
                                    <TextBlock x:Name="GpuBenchmarkText"
                                               TextWrapping="Wrap"
                                               Foreground="#1D4ED8"
                                               FontWeight="SemiBold"
                                               Margin="0,5,12,0"/>
                                </StackPanel>
                                <Button x:Name="BenchmarkButton"
                                        Grid.Column="1"
                                        Content="检测并测速"
                                        Click="BenchmarkButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,13,0,0" TextWrapping="Wrap"
                                   Foreground="#64748B" FontSize="12"
                                   Text="测速单位是“候选点对/秒”，并不等于完整搜索状态/秒。最终速度仍受交点生成、状态去重和构造深度影响。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource GlassSurfaceBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="18"
                Margin="16,4,16,14" Padding="14,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click"/>
                <Button Content="保存设置" Click="SaveButton_Click"
                        Background="{StaticResource GlassAccentBrush}"
                        Foreground="#FFFFFF" BorderBrush="#AFFFFFFF"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
