<Application x:Class="GeometryGrid.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            GeometryGrid Liquid Glass theme. The macro glass surfaces are now
            rendered by the embedded martin65536/liquid-glass-webgl WebGL
            renderer; these brushes provide readable WPF content and a safe
            fallback when WebView2/WebGL is unavailable.
        -->
        <Color x:Key="InkColor">#15233B</Color>
        <Color x:Key="MutedInkColor">#60718D</Color>
        <Color x:Key="AccentColor">#3B70F2</Color>
        <Color x:Key="AccentDeepColor">#2457D6</Color>
        <Color x:Key="GlassBorderColor">#A8FFFFFF</Color>

        <FontFamily x:Key="AppFontFamily">./Assets/Fonts/#Noto Sans CJK SC</FontFamily>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
        <SolidColorBrush x:Key="GlassHairlineBrush" Color="#6F8FB8DC"/>
        <SolidColorBrush x:Key="GlassInputBrush" Color="#C9FFFFFF"/>
        <SolidColorBrush x:Key="GlassInputFocusedBrush" Color="#F4FFFFFF"/>

        <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF2FF" Offset="0"/>
            <GradientStop Color="#F7F5FF" Offset=".46"/>
            <GradientStop Color="#E9F7FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#67FFFFFF" Offset="0"/>
            <GradientStop Color="#45FFFFFF" Offset=".5"/>
            <GradientStop Color="#35EAF3FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassStrongSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FFFFFF" Offset="0"/>
            <GradientStop Color="#E8FFFFFF" Offset=".58"/>
            <GradientStop Color="#D7EDF5FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F2FFFFFF" Offset="0"/>
            <GradientStop Color="#CDEBF3FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8DCEBFF" Offset="0"/>
            <GradientStop Color="#D8C9DDFF" Offset=".55"/>
            <GradientStop Color="#D6C6D5FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassAccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#728FFBFF" Offset="0"/>
            <GradientStop Color="#EF4B7DF5" Offset=".48"/>
            <GradientStop Color="#F12D5DDD" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassAccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8AA7FFFF" Offset="0"/>
            <GradientStop Color="#F75A89F8" Offset=".48"/>
            <GradientStop Color="#F53867E6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BFFFFFFF" Offset="0"/>
            <GradientStop Color="#34FFFFFF" Offset=".26"/>
            <GradientStop Color="#00FFFFFF" Offset=".58"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiquidToggleOffBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6C7D8DA4" Offset="0"/>
            <GradientStop Color="#49718195" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiquidToggleOnBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF48D96C" Offset="0"/>
            <GradientStop Color="#FF28B94E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiquidToggleKnobBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#F0EAF4FF" Offset=".72"/>
            <GradientStop Color="#D7D9E6F4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiquidSliderTrackBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#55738399" Offset="0"/>
            <GradientStop Color="#38708095" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiquidSliderFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4AA3FF" Offset="0"/>
            <GradientStop Color="#FF1677F2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiquidScrollThumbBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D9FFFFFF" Offset="0"/>
            <GradientStop Color="#9CD5E7F7" Offset=".52"/>
            <GradientStop Color="#B78DB6E8" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="FloatingGlassShadow"
                          Color="#36527C" BlurRadius="24" ShadowDepth="6" Opacity=".18"/>
        <DropShadowEffect x:Key="SoftGlassShadow"
                          Color="#41618F" BlurRadius="14" ShadowDepth="3" Opacity=".15"/>
        <DropShadowEffect x:Key="ToggleKnobShadow"
                          Color="#294969" BlurRadius="8" ShadowDepth="2" Opacity=".26"/>

        <!-- DirectWrite keeps the TTF/OTF glyph outlines as vectors. Display
             formatting, fixed hinting and ClearTypeHint make small UI text align
             to the physical pixel grid even inside composited glass surfaces. -->
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassButtonBrush}"/>
            <Setter Property="BorderBrush" Value="#82FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Border Background="{StaticResource GlassSheenBrush}"
                                            CornerRadius="11" Margin="-10,-5,-10,5"
                                            IsHitTestVisible="False" Opacity=".62"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource GlassButtonHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9A7EB3F2"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B8DDEAFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassInputBrush}"/>
            <Setter Property="BorderBrush" Value="#7398B6D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#734B7DF5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputChrome" Property="Background"
                                        Value="{StaticResource GlassInputFocusedBrush}"/>
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#A94B7DF5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Apple-style Liquid Glass switch. The dimensions, spring travel and
             green accent follow the upstream LiquidToggle visual language. -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,9"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="44" Height="26"
                                    Background="{StaticResource LiquidToggleOffBrush}"
                                    BorderBrush="#6FFFFFFF" BorderThickness="1"
                                    CornerRadius="13" VerticalAlignment="Center">
                                <Grid ClipToBounds="False">
                                    <Border Background="{StaticResource GlassSheenBrush}"
                                            CornerRadius="12" Margin="1,1,1,10"
                                            Opacity=".5" IsHitTestVisible="False"/>
                                    <Border x:Name="SwitchThumb" Width="22" Height="22"
                                            HorizontalAlignment="Left" Margin="1.5"
                                            Background="{StaticResource LiquidToggleKnobBrush}"
                                            BorderBrush="#D8FFFFFF" BorderThickness="1"
                                            CornerRadius="11"
                                            Effect="{StaticResource ToggleKnobShadow}"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background"
                                        Value="{StaticResource LiquidToggleOnBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#8AFFFFFF"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="19.5,1.5,1.5,1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#D6FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwitchThumb" Property="Width" Value="24"/>
                                <Setter TargetName="SwitchThumb" Property="Opacity" Value=".94"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="2,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="{StaticResource LiquidSliderFillBrush}"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="{StaticResource LiquidSliderTrackBrush}"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="SliderThumb"
                                                        Background="{StaticResource LiquidToggleKnobBrush}"
                                                        BorderBrush="#D8FFFFFF" BorderThickness="1"
                                                        CornerRadius="12"
                                                        Effect="{StaticResource ToggleKnobShadow}">
                                                    <Border Background="{StaticResource GlassSheenBrush}"
                                                            CornerRadius="11" Margin="1,1,1,10"
                                                            Opacity=".6"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SliderThumb" Property="BorderBrush" Value="#FF4A9FFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="SliderThumb" Property="Background" Value="#F1DCEBFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LiquidScrollThumbBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Margin="1,3">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="LiquidScrollThumb" MinHeight="38" MinWidth="7">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ScrollThumbChrome"
                                                        Background="{StaticResource LiquidScrollThumbBrush}"
                                                        BorderBrush="#B8FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Margin="1"
                                                        Effect="{StaticResource SoftGlassShadow}">
                                                    <Border Background="{StaticResource GlassSheenBrush}"
                                                            CornerRadius="5" Margin="1,1,1,4"
                                                            Opacity=".48"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ScrollThumbChrome" Property="Background" Value="#D5AFCBFF"/>
                                                        <Setter TargetName="ScrollThumbChrome" Property="BorderBrush" Value="#E8FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ScrollThumbChrome" Property="Background" Value="#E695B8F5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="LiquidScrollThumb" Property="MinHeight" Value="7"/>
                                <Setter TargetName="LiquidScrollThumb" Property="MinWidth" Value="38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Background" Value="{StaticResource GlassInputBrush}"/>
            <Setter Property="BorderBrush" Value="#7398B6D7"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F2FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#A8FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassStrongSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="GlassFloatingPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource FloatingGlassShadow}"/>
        </Style>
    </Application.Resources>
</Application>
